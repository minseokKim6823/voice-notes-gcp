# Copy to .env. Spring Boot imports this file as environment properties.
# Use an existing MariaDB database allocated to this application.
DATABASE_URL=jdbc:mariadb://localhost:3306/voice_notes
DATABASE_USER=YOUR_DB_USER
DATABASE_PASSWORD=
MONGODB_URI=mongodb://localhost:27017/voice_notes?serverSelectionTimeoutMS=5000&connectTimeoutMS=5000

GOOGLE_CLOUD_PROJECT=
VOICE_NOTES_BUCKET=

# Set API keys from the Z.ai and OpenAI developer consoles.
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-4.7-flash
GLM_TIMEOUT=10m
OPENAI_API_KEY=
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_TIMEOUT=10m
VOICE_NOTES_STT_PROVIDER=whisper
