# Copy to .env. Spring Boot imports this file as environment properties.
# Use an existing MariaDB database allocated to this application.
DATABASE_URL=jdbc:mariadb://localhost:3306/voice_notes
DATABASE_USER=YOUR_DB_USER
DATABASE_PASSWORD=
MONGODB_URI=mongodb://localhost:27017/voice_notes?serverSelectionTimeoutMS=5000&connectTimeoutMS=5000

GOOGLE_CLOUD_PROJECT=
VOICE_NOTES_BUCKET=

# Groq free plan: https://console.groq.com/keys (limits apply).
LLM_PROVIDER=groq
GROQ_API_KEY=
# Defaults: https://api.groq.com/openai/v1 and openai/gpt-oss-120b.
# Speed-first alternative: LLM_MODEL=openai/gpt-oss-20b (evaluate quality).
LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=2048
# To use GLM: LLM_PROVIDER=glm and set GLM_API_KEY.
# GLM_API_KEY=
# This OpenAI key is for STT only. Summary requests use Groq.
OPENAI_API_KEY=
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_TIMEOUT=10m
VOICE_NOTES_STT_PROVIDER=whisper
