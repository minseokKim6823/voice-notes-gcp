# Copy to application-local.yml. Spring Boot loads that file from the project root.
# Use an existing MariaDB database allocated to this application.
spring:
  datasource:
    url: jdbc:mariadb://localhost:3306/voice_notes
    username: YOUR_DB_USER
    password: ""
  data:
    mongodb:
      uri: mongodb://localhost:27017/voice_notes?serverSelectionTimeoutMS=5000&connectTimeoutMS=5000

voice-notes:
  # Defaults match the local ClickHouse service in compose.yaml.
  # analytics:
  #   enabled: true
  #   url: http://localhost:8123
  #   database: voice_notes
  #   username: voice_notes
  #   password: local-analytics-only
  stt-provider: whisper
  # Set OPENAI_API_KEY in the server environment (never in browser JavaScript).
  # whisper:
  #   api-key: YOUR_OPENAI_API_KEY
  project-id: ""
  bucket: ""
  exaone:
    # GLM-4.7-Flash is listed as free on Z.ai's API pricing page.
    # Set GLM_API_KEY in the server environment; do not commit API keys.
    base-url: https://api.z.ai/api/paas/v4
    model: glm-4.7-flash
    include-chat-template-kwargs: false
